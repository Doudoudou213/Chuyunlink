.explore-page { padding-top: 20rpx; }
.hero { position: relative; overflow: hidden; min-height: 340rpx; padding: 50rpx 42rpx; box-sizing: border-box; border-radius: 28rpx; background: #17110f; color: #f3ebdd; }
.hero-title { display: block; width: 76%; margin-top: 26rpx; font-size: 56rpx; line-height: 1.18; }
.hero-copy { display: block; width: 78%; margin-top: 24rpx; color: rgba(243,235,221,.72); font-size: 25rpx; line-height: 1.7; }
.lacquer-trace { position: absolute; right: 38rpx; top: 52rpx; width: 44rpx; height: 244rpx; display: flex; flex-direction: column; align-items: center; }
.trace-line { width: 4rpx; flex: 1; background: linear-gradient(#b68a4a, #9e2f24); }
.trace-node { width: 24rpx; height: 24rpx; border: 5rpx solid #b68a4a; border-radius: 50%; background: #17110f; }
.trace-node.small { width: 13rpx; height: 13rpx; border-color: #9e2f24; }
.resource-rail { width: 100%; white-space: nowrap; }
.resource-card { position: relative; display: inline-flex; flex-direction: column; width: 500rpx; min-height: 350rpx; margin-right: 20rpx; padding: 34rpx; box-sizing: border-box; vertical-align: top; white-space: normal; }
.resource-index { position: absolute; top: 25rpx; right: 28rpx; color: rgba(158,47,36,.2); font-family: Georgia, serif; font-size: 76rpx; }
.resource-type, .submission-meta { color: #9e2f24; font-size: 22rpx; font-weight: 650; }
.resource-title { display: block; margin-top: 42rpx; padding-right: 70rpx; color: #17110f; font-size: 38rpx; line-height: 1.35; }
.resource-summary { display: -webkit-box; overflow: hidden; margin-top: 18rpx; color: #756c66; font-size: 25rpx; line-height: 1.65; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.tag-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: auto; padding-top: 26rpx; }
.tag { padding: 7rpx 14rpx; border-radius: 999rpx; background: rgba(73,106,97,.1); color: #496a61; font-size: 20rpx; }
.submission-card { overflow: hidden; margin-bottom: 22rpx; }
.submission-image { display: block; width: 100%; height: 330rpx; background: #ded5c6; }
.submission-body { padding: 30rpx; }
.submission-title { display: block; margin-top: 12rpx; color: #17110f; font-size: 38rpx; }
.submission-copy { display: block; margin-top: 14rpx; color: #756c66; font-size: 25rpx; line-height: 1.65; }
.story-lead { display: flex; gap: 16rpx; margin-top: 24rpx; padding: 22rpx; border-left: 4rpx solid #9e2f24; background: rgba(158,47,36,.05); color: #2b2421; font-size: 24rpx; line-height: 1.6; }
.story-mark { flex: none; color: #9e2f24; font-family: "Songti SC", serif; font-weight: 700; }

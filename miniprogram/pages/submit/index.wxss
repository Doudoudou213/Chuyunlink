.page-title { display: block; margin-top: 18rpx; color: #17110f; font-size: 50rpx; line-height: 1.25; }
.page-intro { display: block; margin-top: 22rpx; color: #756c66; font-size: 26rpx; line-height: 1.75; }
.login-card { margin-top: 34rpx; padding: 30rpx; }
.login-title { display: block; color: #17110f; font-weight: 650; }
.login-copy { display: block; margin: 10rpx 0 24rpx; color: #756c66; font-size: 24rpx; line-height: 1.6; }
.form-card { margin-top: 26rpx; padding: 30rpx; }
.field { margin-bottom: 32rpx; }
.field-label { display: block; margin-bottom: 14rpx; color: #2b2421; font-size: 24rpx; font-weight: 650; }
input, textarea { width: 100%; box-sizing: border-box; border: 1rpx solid rgba(43,36,33,.16); border-radius: 16rpx; background: #fbf7ef; font-size: 27rpx; }
input { height: 88rpx; padding: 0 22rpx; }
textarea { height: 210rpx; padding: 22rpx; line-height: 1.6; }
.media-picker { overflow: hidden; height: 320rpx; border: 2rpx dashed rgba(158,47,36,.35); border-radius: 18rpx; background: #fbf7ef; }
.media-preview { width: 100%; height: 100%; }
.media-empty { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #756c66; font-size: 24rpx; }
.media-plus { color: #9e2f24; font-family: Georgia, serif; font-size: 64rpx; }
.consent-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 22rpx 0; border-top: 1rpx solid rgba(43,36,33,.1); }
.consent-title, .consent-copy { display: block; }
.consent-title { color: #2b2421; font-size: 25rpx; }
.consent-copy { margin-top: 7rpx; color: #756c66; font-size: 21rpx; }
.submit-button { margin-top: 30rpx; }

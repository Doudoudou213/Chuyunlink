.detail-page { min-height: 100vh; background: #f3ebdd; }
.detail-hero { padding: 72rpx 40rpx 62rpx; background: #17110f; color: #f3ebdd; }
.detail-title { display: block; margin-top: 22rpx; font-size: 58rpx; line-height: 1.2; }
.detail-rule { width: 86rpx; height: 5rpx; margin-top: 34rpx; background: linear-gradient(90deg, #9e2f24, #b68a4a); }
.detail-summary { display: block; margin-top: 28rpx; color: rgba(243,235,221,.72); font-size: 27rpx; line-height: 1.8; }
.detail-body { padding: 0 28rpx 60rpx; }
.story-panel { padding: 34rpx; }
.story-copy { color: #2b2421; font-family: "Songti SC", serif; font-size: 30rpx; line-height: 1.95; }
.source-note { margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(43,36,33,.12); color: #756c66; font-size: 22rpx; line-height: 1.6; }
.source-label { margin-right: 16rpx; color: #496a61; font-weight: 650; }
.collect-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.collect-item { padding: 17rpx 22rpx; border: 1rpx solid rgba(182,138,74,.35); border-radius: 14rpx; background: #fffdf8; color: #2b2421; font-size: 24rpx; }
